{
  "waitTimeoutMs": 1800000,
  "sendWaitTimeoutMs": 1800000,
  "permissionTimeoutMs": 1800000,
  "maxPendingPermissions": 16,
  "startupTimeoutMs": 120000,
  "maxEventsPerSession": 5000,
  "maxEventLogBytes": 16777216,
  "maxEventBytes": 262144,
  "retainClosedMs": 3600000,
  "backends": {
    "my-agent": {
      "command": "node",
      "args": ["tools/my-acp-agent.js"],
      "env": {
        "MY_FLAG": "1"
      },
      "description": "an in-repo ACP agent",
      "defaultMode": "auto"
    }
  }
}
